{
  "protocol": "FATST-paper-facing-evaluation",
  "version": "1.2",
  "effective_date": "2026-07-18",
  "standard_long_term_forecasting": {
    "horizons": [96, 192, 336, 720],
    "primary_metric": "mse",
    "secondary_metric": "mae",
    "required_reporting": [
      "per_dataset_horizon_metrics",
      "paired_relative_gain",
      "macro_relative_gain",
      "cell_wins",
      "dataset_wins"
    ],
    "default_validation_checkpoint_score": "mean_mse_h96_h192_h336_h720"
  },
  "split_roles": {
    "train": "parameter_optimization_and_train_only_diagnostics",
    "validation": "checkpoint_selection_hyperparameter_choice_debugging_and_explanatory_diagnostics_only",
    "test": "formal_mechanism_effectiveness_main_result_and_formal_ablation"
  },
  "dense_evaluation": {
    "default_role": "diagnostic_and_unified_horizon_supporting_evidence",
    "includes": [
      "dense_h1_to_h720_curve",
      "dense_prefix_auc",
      "horizon_bins",
      "per_epoch_trajectory",
      "gradient_router_and_arm_statistics"
    ],
    "primary_use_requires_preregistration": true
  },
  "test_audit": {
    "benchmark_role": "test_primary_test_informed_candidate_decision_surface",
    "formal_mechanism_evaluation_requires_test": true,
    "validation_cannot_pass_or_reject_mechanism": true,
    "per_dataset_horizon_or_cell_tuning_forbidden": true,
    "freeze_before_access": [
      "candidate_version",
      "source_commit",
      "architecture",
      "objective",
      "dataset_profiles",
      "seeds",
      "checkpoint_rule",
      "checkpoint_hashes",
      "main_and_ablation_matrix",
      "metrics",
      "gates",
      "rollback_consequences"
    ],
    "post_test_redesign_creates_test_informed_candidate": true,
    "untouched_holdout_claim_forbidden": true,
    "risk_controls": [
      "complete_frozen_matrix",
      "negative_result_reporting",
      "matched_controls",
      "multi_seed_confirmation"
    ]
  },
  "historical_checkpoint_fairness": {
    "h720_only_checkpoint_must_be_retrained": true,
    "matched_arms_share_four_horizon_validation_selector": true
  },
  "mechanism_evaluation_layers": {
    "required": [
      "paper_facing_effectiveness",
      "matched_mechanism_attribution",
      "internal_mechanism_health",
      "failure_attribution"
    ],
    "paper_facing_effectiveness": {
      "source": "official_test_complete_frozen_matrix",
      "required_metrics": ["mse", "mae"],
      "role": "performance_viability"
    },
    "matched_mechanism_attribution": {
      "required_control_types": [
        "same_objective_architecture",
        "same_architecture_objective",
        "capacity_or_width",
        "order_or_mapping",
        "matched_initialization"
      ],
      "role": "claim_specificity"
    },
    "internal_mechanism_health": {
      "default_diagnostics": [
        "arm_skill",
        "prediction_diversity",
        "oracle_headroom",
        "policy_usage_and_entropy",
        "gradient_activity",
        "component_contribution",
        "horizon_signature"
      ],
      "cannot_override_negative_effectiveness": true,
      "role": "path_health_and_failure_localization"
    },
    "failure_attribution": {
      "required_classes": [
        "hypothesis_false",
        "intervention_point_wrong",
        "readout_or_head_design_wrong",
        "optimization_or_numeric_pathology",
        "capacity_control_explains"
      ],
      "requires_rollback_step": true,
      "role": "minimum_rejection_boundary"
    },
    "positive_effectiveness_without_attribution_status": "performance_partial_pass",
    "all_layers_required_for_passed_core_candidate": true
  }
}
