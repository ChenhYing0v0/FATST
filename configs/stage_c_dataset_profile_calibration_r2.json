    "relative_winner_reconfirmed": false
  },
  "selection_policy": {
    "primary": "For each dataset and candidate, compute regret relative to the best candidate separately at each dense validation horizon, then average the eight regrets.",
    "tie_breakers": ["lower_max_dense_horizon_regret", "lower_h720_regret", "profile_name"],
    "parameter_count_used_for_selection": false,
    "test_metrics_used_for_selection": false
  },
  "budget": {
