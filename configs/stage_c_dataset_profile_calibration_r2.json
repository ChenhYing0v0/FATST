{
  "stage": "StageC-UVHF",
  "candidate": "SC0-DAP-R2",
  "protocol_class": "mechanism_control",
  "protocol_profile": "stage_c_dataset_profile_calibration_r2",
  "selection_split": "val",
  "selection_metric": "dense_horizon_macro_normalized_regret",
  "datasets": ["Weather", "ETTm1", "ETTh2"],
  "common": {
