    "basis_rank": 256,
    "e_layers": 2,
    "dropout": 0.1,
    "layer_norm": 1,
    "learning_rate": 0.0001,
    "batch_size": 32,
    "gradient_accumulation_steps": 1,
    "max_epochs": 20,
    "early_stopping_patience": 5,
    "early_stopping_min_delta": 0.0,
    "checkpoint_policy": "best-val",
    "pred_loss_mode": "full",
    "final_evaluation_split": "val",
    "screen_seed": 2021,
    "confirmation_seeds": [2022, 2023]
  },
  "phase_a_patch_screen": {
    "fixed_d_model": 64,
    "fixed_d_ff": 128,
    "profiles": {
      "r2a_p12_d64_ff128": {"patch_num": 12, "patch_len": 60, "d_model": 64, "d_ff": 128},
      "r2a_p24_d64_ff128": {"patch_num": 24, "patch_len": 30, "d_model": 64, "d_ff": 128},
      "r2a_p48_d64_ff128": {"patch_num": 48, "patch_len": 15, "d_model": 64, "d_ff": 128}
    }
  },
  "phase_b_width_screen": {
    "rule": "Use the dataset-selected Phase A patch_num; compare natural widths with d_ff=2*d_model.",
    "widths": {
      "narrow": {"d_model": 32, "d_ff": 64},
      "medium": {"d_model": 64, "d_ff": 128},
      "wide": {"d_model": 128, "d_ff": 256}
    }
  },
  "phase_c_stability_confirmation": {
    "rule": "Reuse seed 2021 selection artifacts and run only selected profiles at seeds 2022 and 2023. This confirms absolute validation stability, not the relative winner.",
    "cv_definition": "sample_std(mse_across_three_seeds) / mean(mse_across_three_seeds)",
    "dataset_mean_mse_cv_max": 0.03,
